[node name="L1" type="Label" parent="Panel/Margin/VBox/Body"]
mouse_filter = 2
custom_colors/font_color = Color( 0.28, 0.18, 0.11, 1 )
custom_constants/line_spacing = 7
custom_fonts/font = SubResource( 3 )
text = "你在乡下得到了一座荒废已久的农场。整理旧物时，你在石头下发现了两样东西：一只蒙尘的魔瓶，和一本空白的图鉴。"
autowrap = true

[node name="L2" type="Label" parent="Panel/Margin/VBox/Body"]
modulate = Color( 1, 1, 1, 0 )
mouse_filter = 2
custom_colors/font_color = Color( 0.28, 0.18, 0.11, 1 )
custom_constants/line_spacing = 7
custom_fonts/font = SubResource( 3 )
text = "魔瓶里藏着一座小小的世界。四季在其中流转，土地会呼吸，植物会生长；图鉴则会记下你在瓶中种出的一切。"
autowrap = true

[node name="L3" type="Label" parent="Panel/Margin/VBox/Body"]
modulate = Color( 1, 1, 1, 0 )
mouse_filter = 2
custom_colors/font_color = Color( 0.28, 0.18, 0.11, 1 )
custom_constants/line_spacing = 7
custom_fonts/font = SubResource( 3 )
text = "但瓶中的世界并不只有恩赐。耕作越久，越会惊动藏在暗处的虫子。植物死去，魔瓶就会受损；伤得太重，四季便会停滞。"
autowrap = true

[node name="L4" type="Label" parent="Panel/Margin/VBox/Body"]
modulate = Color( 1, 1, 1, 0 )
mouse_filter = 2
custom_colors/font_color = Color( 0.28, 0.18, 0.11, 1 )
custom_constants/line_spacing = 7
custom_fonts/font = SubResource( 3 )
text = "好在魔瓶会自行修复。随着图鉴一页页填满，它的力量也会慢慢苏醒。至于它为何存在——答案或许就藏在图鉴的最后一页。"
autowrap = true

[node name="Hint" type="Label" parent="Panel/Margin/VBox"]
mouse_filter = 2
custom_colors/font_color = Color( 0.47, 0.31, 0.19, 0.6 )
custom_fonts/font = SubResource( 4 )
text = "点击任意处继续"
align = 1

[node name="Button" type="Button" parent="Panel/Margin/VBox"]
rect_min_size = Vector2( 0, 58 )
